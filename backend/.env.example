# Demo mode starts with sample records and simulates detections for uploaded clips.
DEMO_MODE=true

# Optional overrides. Defaults are relative to the backend directory.
# DATABASE_URL=sqlite:///./saferoad.db
# UPLOAD_DIR=./uploads
# PROCESSED_DIR=./processed
# MAX_UPLOAD_MB=300
# MAX_VIDEO_FRAMES=5000
# PROCESS_EVERY_N_FRAMES=4
# YOLO_CONFIDENCE=0.35
# YOLO_MODEL_PATH=./models/yolov8n.pt
# HIGH_RISK_TTC_SECONDS=1.5
# MEDIUM_RISK_TTC_SECONDS=3.0
# MAX_CONFLICT_DISTANCE_PX=180
# ALLOWED_ORIGINS=*

# Legacy OTP endpoints are retained for compatibility. The website login uses email and password.
LOGIN_DEV_OTP=false
LOCAL_LOGIN_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# AUTH_SECRET=generate-a-long-random-secret-if-managing-this-manually
